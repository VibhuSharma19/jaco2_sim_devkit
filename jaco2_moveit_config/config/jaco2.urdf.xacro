<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jaco2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import jaco2 urdf file -->
    <xacro:include filename="$(find jaco2_description)/urdf/jaco2_standalone.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="jaco2.ros2_control.xacro" />


    <xacro:jaco2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
