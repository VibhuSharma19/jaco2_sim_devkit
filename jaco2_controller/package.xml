<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jaco2_controller</name>
  <version>0.0.0</version>
  <description>Controller package for jaco2 manipulator</description>
  <maintainer email="1999vibhusharma@gmail.com">Vibhu Sharma</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>
  
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <build_depend>controller_manager</build_depend>
  <build_depend>jaco2_description</build_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>jaco2_description</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
