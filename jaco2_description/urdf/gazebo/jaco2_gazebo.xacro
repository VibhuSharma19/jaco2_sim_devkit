          <height>500</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>10</far>
        </clip>
        <save enabled="false">
          <path>bounding_box_3d_data</path>
        </save>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo> -->

