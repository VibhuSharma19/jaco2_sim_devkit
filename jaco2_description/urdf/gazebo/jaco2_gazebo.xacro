<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jaco2">

<xacro:macro name="gazebo_config" params="robot_namespace">

  <!-- ROS 2 Control -->
  <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find jaco2_controller)/config/jaco2_controllers.yaml</parameters> 
      </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
    </plugin>    
</gazebo> 

  <!--<gazebo>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo> -->

  <gazebo>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>jaco2_joint_finger_1</joint_name>
      <initial_position>0.0000</initial_position>
    </plugin>
  </gazebo>

  <gazebo reference="rgbd_camera">
    <sensor name="rgbdcamera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>500</width>
          <height>500</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>10</far>
        </clip>
        <optical_frame_id>rgbd_camera</optical_frame_id>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <gz_frame_id>rgbd_camera</gz_frame_id>
      <topic>camera</topic>
      <enable_metrics>true</enable_metrics>
    </sensor>
  </gazebo>

  <!-- <gazebo reference="rgbd_camera">
